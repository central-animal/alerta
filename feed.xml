---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="feed.xsl"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="3.10.0">Jekyll</generator>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/feed.xml</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author.name | default: site.title }}</name>
  </author>

  {% assign ocorrencias_ordenadas = site.ocorrencias | sort: "date" | reverse %}
  {% for post in ocorrencias_ordenadas limit:20 %}
  
  {% assign local_final = post.localidade %}
  {% unless local_final != "" and local_final != nil %}
    {% assign local_final = post.concelho %}
    {% unless local_final != "" and local_final != nil %}
      {% assign local_final = post.distrito %}
      {% unless local_final != "" and local_final != nil %}
        {% assign local_final = post.localizacao %}
      {% endunless %}
    {% endunless %}
  {% endunless %}

  {% assign esp = post.especie | upcase %}
  {% assign niv = post.nivel_alerta | upcase %}
  {% assign loc = local_final | upcase %}

  {% assign title_parts = "" %}
  {% if post.especie != "" and post.especie != nil %}
    {% assign title_parts = esp %}
  {% endif %}

  {% if post.nivel_alerta != "" and post.nivel_alerta != nil %}
    {% if title_parts != "" %}
      {% assign title_parts = title_parts | append: " - " | append: niv %}
    {% else %}
      {% assign title_parts = niv %}
    {% endif %}
  {% endif %}

  {% if local_final != "" and local_final != nil %}
    {% if title_parts != "" %}
      {% assign title_parts = title_parts | append: " - " | append: loc %}
    {% else %}
      {% assign title_parts = loc %}
    {% endif %}
  {% endif %}

  {% if title_parts == "" %}
    {% assign title_parts = "ALERTA" %}
  {% endif %}

  <entry>
    <title>{{ title_parts | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <published>{% if post.data_ocorrencia_inicial != "" and post.data_ocorrencia_inicial != nil %}{{ post.data_ocorrencia_inicial | date: "%Y-%m-%dT00:00:00Z" }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url }}</id>
    <summary type="html"><![CDATA[{{ post.estado_fisico }} — Situação: {{ post.situacao }} | {{ post.observacoes | strip_html | truncate: 120 }}]]></summary>
    <content type="html"><![CDATA[
      {% if post.imagem != "" and post.imagem != nil %}
      <p><img src="{% if post.imagem contains 'http' %}{{ post.imagem }}{% else %}{{ site.url }}{{ site.baseurl }}{{ post.imagem }}{% endif %}" alt="Fotografia do animal" /></p>
      {% endif %}

      <p><strong>Estado Físico:</strong> {{ post.estado_fisico }}<br />
      <strong>Situação:</strong> {{ post.situacao }}</p>
      
      {% if post.observacoes != "" and post.observacoes != nil %}
      <p><strong>Detalhes:</strong><br />
      {{ post.observacoes }}</p>
      {% endif %}

      <p><a href="{{ post.url | absolute_url }}">Ver ocorrência completa no site</a><br />
      <em>Publicado a {{ post.date | date: "%d/%m/%Y" }}</em></p>
    ]]></content>
  </entry>
  {% endfor %}
</feed>
